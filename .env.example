# Copy to .env.local, then replace the placeholder key. Never commit that file.
# PaperMotion local browser deployment (Next.js reads .env.local automatically).
GETIT_WEB=1
GETIT_DEFAULT_PROVIDER=pi
GETIT_DATA_DIR=./data

# Server-side API settings. Do not use NEXT_PUBLIC_ for credentials.
# Include /v1, but not /responses or /chat/completions, in the base URL.
PI_URL=https://copilot.chillicurry.uk/v1
PI_API_KEY=replace_with_your_api_key
PI_API_TYPE=openai-responses
PI_MODEL_FAST=gpt-6-astra
PI_MODEL_SMART=gpt-6-astra

# Other OpenAI-compatible endpoints may use openai-completions instead.
# Select an API type and model supported by your chosen provider.
# Original CLI providers remain available: codex, gemini, claude, pi.
# GEMINI_API_KEY=replace_with_your_gemini_key
# ANTHROPIC_API_KEY=replace_with_your_anthropic_key

# Generate visualizations when requested; can also be changed in Settings.
NEXT_PUBLIC_AUTO_GENERATE_VIZ=false
NEXT_PUBLIC_MAX_VIZ_GEN_RETRIES=3

GETIT_DISABLE_ANALYTICS=1
NEXT_TELEMETRY_DISABLED=1
